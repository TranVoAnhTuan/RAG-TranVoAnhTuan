APP_VERSION = 1.0.1

# ── LLM Models ─────────────────────────────────────────────────────────
LLM_MODEL = "google/gemma-4-E4B-it"
BASE_URL = "http://host.docker.internal:8080/v1"

# ── API Keys ───────────────────────────────────────────────────────────
GOOGLE_API_KEY="<YOUR_GOOGLE_API_KEY>"
OLLAMA_API_KEY="<YOUR_OLLAMA_API_KEY>"
API_KEY="<YOUR_OPENAI_OR_OTHER_API_KEY>"
HUGGINGFACE_ACCESS_TOKEN="<YOUR_HUGGINGFACE_TOKEN>"
TAVILY_API_KEY="<YOUR_TAVILY_API_KEY>"

# ── Qdrant ─────────────────────────────────────────────────────────────
QDRANT_URL="<YOUR_QDRANT_CLUSTER_URL>"
QDRANT_API_KEY="<YOUR_QDRANT_API_KEY>"
QDRANT_COLLECTION_NAME="intern_rag_agent_test"

# ── MongoDB ────────────────────────────────────────────────────────────
DATABASE_HOST="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app_name>"

# ── Local Storage (MinIO & SQLite) ─────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=rag-agent
MINIO_SECRET_KEY=89898989
MINIO_BUCKET_NAME=rag-documents
SQLITE_DB_PATH=rag_database.db

# ── Embeddings / Reranker ──────────────────────────────────────────────
SPARSE_MODEL_NAME="Qdrant/bm42-all-minilm-l6-v2-attentions"
DENSE_MODEL_NAME="Qwen/Qwen3-Embedding-0.6B"
CONTEXT_LENGTH=512
RERANKER_MODEL_NAME="jinaai/jina-reranker-v3"

# ── LangSmith Tracing ──────────────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="<YOUR_LANGSMITH_API_KEY>"
LANGSMITH_PROJECT="rag_agent"

# ── TLS / Certificates ─────────────────────────────────────────────────
SSL_CERT_FILE=/home/jacktran/RAG/experiment/rag_agentic_system/combined.pem
REQUESTS_CA_BUNDLE=/home/jacktran/RAG/experiment/rag_agentic_system/combined.pem

# ── App Logic ──────────────────────────────────────────────────────────
MCP_SERVER_URL=http://localhost:8001/mcp
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=86400
